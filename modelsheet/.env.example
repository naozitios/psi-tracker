# Required. SEC asks every client to identify itself with a name and contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="ModelSheet dev you@example.com"

# Required for the chat assistant. Billed per token to the key's Anthropic
# Console account (API credits), not to a Claude.ai plan.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Required in production: a Postgres connection string. Without it, local
# development uses an in-process Postgres (PGlite) stored in .data/pglite.
# DATABASE_URL=postgres://user:password@host:5432/modelsheet

# Required in production: signs guest session cookies. At least 32 random characters.
# SESSION_SECRET=

# Optional limits on assistant requests (the only thing that spends API credits).
# AGENT_LIMIT_PER_USER_HOUR=20
# AGENT_LIMIT_PER_USER_DAY=60
# AGENT_LIMIT_GLOBAL_DAY=500
